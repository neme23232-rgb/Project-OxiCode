{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oxicode",
  "version": "0.1.0",
  "identifier": "com.oxicode.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "oxicode",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
